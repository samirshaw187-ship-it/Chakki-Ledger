{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profiles including Shop Owner and Admin accounts with roles and approval states.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN"] },
        "isActive": { "type": "boolean" },
        "approvalStatus": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "SUSPENDED", "DEACTIVATED", "BLOCKED"] },
        "rejectionReason": { "type": "string" },
        "resetRequested": { "type": "boolean" },
        "resetInitiatedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "phone", "role", "isActive", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer khata profile with balance states for wheat and cash dues.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerCode": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "alternatePhone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "isActive": { "type": "boolean" },
        "currentDueAmount": { "type": "number" },
        "wheatBalanceKg": { "type": "number" },
        "riceCreditAmount": { "type": "number" },
        "lastTransactionAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerCode", "name", "status", "isActive", "currentDueAmount", "wheatBalanceKg", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Master transaction record for milling, atta exchange, rice trading, settlements, and sales.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionNumber": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "grossAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "netAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceDelta": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "items": { "type": "array" },
        "createdById": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "transactionNumber", "type", "status", "date", "grossAmount", "netAmount", "paidAmount", "balanceDelta", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment receipts collected or paid out.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "date": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "mode": { "type": "string" },
        "status": { "type": "string" },
        "createdById": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "receiptNumber", "date", "customerId", "amount", "mode", "createdAt"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Dual-sided chronological ledger entries for grains and cash.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "transactionId": { "type": "string" },
        "entryType": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "amount": { "type": "number" },
        "direction": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "transactionId", "entryType", "direction", "description", "date", "createdAt"]
    },
    "Wholesaler": {
      "title": "Wholesaler",
      "description": "Rice and grain wholesale buyers and sellers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wholesalerCode": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "totalRicePurchasedKg": { "type": "number" },
        "totalOutstandingPayment": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "wholesalerCode", "name", "status", "isActive", "createdAt"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Stock movements in and out for wheat, rice, and flours.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "inventoryItemId": { "type": "string" },
        "movementType": { "type": "string" },
        "quantity": { "type": "number" },
        "direction": { "type": "string" },
        "referenceId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "inventoryItemId", "movementType", "quantity", "direction", "createdAt"]
    },
    "RateConfiguration": {
      "title": "RateConfiguration",
      "description": "Business milling rates, selling prices, and grain purchase rates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chaliAttaExchangeRate": { "type": "number" },
        "rollAttaExchangeRate": { "type": "number" },
        "rollAttaSellingRate": { "type": "number" },
        "ricePurchaseRate": { "type": "number" },
        "effectiveFrom": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "chaliAttaExchangeRate", "rollAttaExchangeRate", "rollAttaSellingRate", "ricePurchaseRate", "effectiveFrom", "isActive"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Audit trail records for security, dispute prevention, and traceability.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "performedById": { "type": "string" },
        "performedByName": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "entityType", "entityId", "performedById", "performedByName", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profiles indexed by UID" },
    "/customers/{customerId}": { "schema": "Customer", "description": "Customer khata profiles" },
    "/transactions/{transactionId}": { "schema": "Transaction", "description": "Milling and trade transactions" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Customer payments and receipts" },
    "/ledgerEntries/{entryId}": { "schema": "LedgerEntry", "description": "Grain and cash ledger lines" },
    "/wholesalers/{wholesalerId}": { "schema": "Wholesaler", "description": "Wholesale trade contacts" },
    "/inventoryMovements/{movementId}": { "schema": "InventoryMovement", "description": "Inventory changes" },
    "/settings/rates": { "schema": "RateConfiguration", "description": "Global rates configuration" },
    "/auditLogs/{logId}": { "schema": "AuditLogEntry", "description": "Immutable security audit logs" }
  }
}
