rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.email in ['samirpc187@gmail.com', 'admin@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'ADMIN')
      );
    }

    function isOwnerOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'OWNER' &&
         getUserData().isActive == true)
      );
    }

    // User Profiles
    match /users/{userId} {
      // Any authenticated user can read user profiles to verify permissions and author names
      allow read: if isAuthenticated();

      // Account creation: Authenticated user creating their own profile document with their uid
      // Role self-assignment to ADMIN is only permitted if no prior admin exists or verified by admin
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Updates: Admins can update any user; users can only update basic info on their own profile, not their role or approval status
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approvalStatus', 'isActive'])
      );

      // Deletes: Only platform admin can delete accounts
      allow delete: if isAdmin();
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isOwnerOrAdmin();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isOwnerOrAdmin();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isOwnerOrAdmin();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isAdmin();
    }

    // Ledger Entries
    match /ledgerEntries/{entryId} {
      allow read: if isOwnerOrAdmin();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isAdmin();
    }

    // Wholesalers
    match /wholesalers/{wholesalerId} {
      allow read: if isOwnerOrAdmin();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isAdmin();
    }

    // Inventory Movements
    match /inventoryMovements/{movementId} {
      allow read: if isOwnerOrAdmin();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isAdmin();
    }

    // Rate Settings & Configurations
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isAuthenticated();
      // Audit logs are strictly immutable: no updates or deletes permitted
      allow update, delete: if false;
    }
  }
}
