rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow read and write for authenticated users or active app operations
    match /{document=**} {
      allow read, write: if isAuthenticated() || request.time < timestamp.date(2027, 1, 1);
    }
  }
}

